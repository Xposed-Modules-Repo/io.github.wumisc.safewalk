<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 相机/闪光灯非必需，避免没闪光灯的设备装不上 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:label="安全出行"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Safewalk">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="安全出行"
            android:theme="@style/Theme.Safewalk">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EmergencyCardActivity"
            android:exported="true"
            android:label="急救卡" />

        <activity
            android:name=".LabActivity"
            android:exported="false"
            android:label="功能实验区" />

        <activity
            android:name=".RearCamSettingsActivity"
            android:exported="false"
            android:label="后置看路设置" />

        <activity
            android:name=".AcknowledgementsActivity"
            android:exported="false"
            android:label="致敬名单" />

        <activity
            android:name=".DonateQrActivity"
            android:exported="false"
            android:label="捐赠二维码" />

        <activity
            android:name=".TipsActivity"
            android:exported="false"
            android:label="出门踩坑指南" />

        <!-- 手电筒通知按钮广播接收器 -->
        <receiver
            android:name=".torch.TorchActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.wumisc.safewalk.OPEN_TORCH"/>
                <action android:name="io.github.wumisc.safewalk.CLOSE_TORCH"/>
            </intent-filter>
        </receiver>

        <!-- LSPosed 模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="SafeWalk 安全出行低功耗提醒：电量预警、证件提醒、久坐提醒、社交礼仪提示。仅Hook系统进程，硬件计步检测，低功耗。" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:value="android" />
    </application>

</manifest>
