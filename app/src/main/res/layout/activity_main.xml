<?xml version="1.0" encoding="utf-8"?>
<!--
    主界面（首页 + 关于）。
    版式统一到「医疗急救卡」：灰底页（#F2F2F7）+ 平角白卡片 + 行间 1px 分隔线
    + 24sp 粗标题 + 13sp 灰副标题。原来的米黄背景、圆角磁贴、emoji 图标框全部去掉，
    因为四个二级页面各写一套视觉，改一个颜色要改四处 —— 这才是「样式不统一」的根因。

    根布局仍是 FrameLayout：底部导航栏要悬浮叠加在页面内容之上，
    这样 drawBackdrop 才能捕获到背后的画面（液态玻璃折射的前提）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ==================== 首页 ==================== -->
        <ScrollView
            android:id="@+id/page_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="110dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="安全出行"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="海阔天空，勇敢去走。步行状态由模块自行判定，不依赖 GMS。"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp" />

                <!-- 四个入口 = 一张白卡片的四行，与急救卡的字段卡同一套语言 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/card_bg"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/tile_enable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="总开关"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tile_enable_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="已关闭"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/chevron"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginLeft="16dp"
                        android:background="@color/bg" />

                    <LinearLayout
                        android:id="@+id/tile_smart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="智能提醒"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tile_smart_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="5 项全部开启"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/chevron"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginLeft="16dp"
                        android:background="@color/bg" />

                    <LinearLayout
                        android:id="@+id/tile_walk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="行走模式"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tile_walk_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="行走模式已关闭"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/chevron"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginLeft="16dp"
                        android:background="@color/bg" />

                    <LinearLayout
                        android:id="@+id/tile_emergency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="急救卡"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tile_emergency_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="点击编辑"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/chevron"
                            android:textSize="20sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 【系统 UI 适配】两行结构（4.3 起取代原来的「HyperOS 版本适配」卡片）：
                     第一行：一行注明，讲清「本机被识别成哪一家」以及是不是手选的；
                     第二行：七个芯片，自动 + 五家厂商（小米/荣耀/OPPO/vivo/华为）+ 原生。
                     芯片上写厂商短名而不是 UI 全名：360dp 宽的机器每个芯片只有约 43dp，
                     “OriginOS”“HarmonyOS”放不下；UI 全名在上一行注明里给。
                     为什么不再按 HyperOS 版本分：三个策略函数（前台服务 / 手电 / 悬浮窗）
                     全是运行时降级链，版本号一次都没被读过；真正影响行为的是「哪一家 UI」，
                     它决定自启动页跳哪儿、第 4 步文案怎么写、用哪张相机包名表。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/card_bg"
                    android:orientation="vertical"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/tv_rom_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="正在识别系统 UI…"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp" />

                    <!--
                        六个厂商 + 原生 + 自动 = 8 个芯片。
                        360dp 宽的机器一行放 8 个，每个只剩约 36dp，「OPPO」都挤不下，
                        所以改两行四列：每行 4 个 × weight=1，宽度自动均分，
                        大屏小屏都不会溢出，也不用再靠 autoSize 缩到 7sp 勉强塞进去。
                    -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_rom_auto"
                            style="@style/RomChip"
                            android:text="自动" />

                        <TextView
                            android:id="@+id/chip_rom_hyperos"
                            style="@style/RomChip"
                            android:layout_marginStart="5dp"
                            android:text="小米" />

                        <TextView
                            android:id="@+id/chip_rom_magicos"
                            style="@style/RomChip"
                            android:layout_marginStart="5dp"
                            android:text="荣耀" />

                        <TextView
                            android:id="@+id/chip_rom_coloros"
                            style="@style/RomChip"
                            android:layout_marginStart="5dp"
                            android:text="OPPO" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_rom_originos"
                            style="@style/RomChip"
                            android:text="vivo" />

                        <TextView
                            android:id="@+id/chip_rom_harmonyos"
                            style="@style/RomChip"
                            android:layout_marginStart="5dp"
                            android:text="华为" />

                        <TextView
                            android:id="@+id/chip_rom_flyme"
                            style="@style/RomChip"
                            android:layout_marginStart="5dp"
                            android:text="魅族" />

                        <TextView
                            android:id="@+id/chip_rom_aosp"
                            style="@style/RomChip"
                            android:layout_marginStart="5dp"
                            android:text="原生" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ==================== 关于 ==================== -->
        <ScrollView
            android:id="@+id/page_about"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true"
            android:padding="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="110dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_about_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关于"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_about_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="安全出行 · LSPosed 模块"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:text="多少次 迎着冷眼与嘲笑，从没有放弃过心中的理想"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp"
                    android:textStyle="italic" />

                <!-- 条目卡：一行一个入口，行间分隔 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/card_bg"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btn_permissions"
                        style="@style/RowStyle">

                        <TextView
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="权限与无障碍" />

                        <TextView
                            style="@style/RowChevron" />
                    </LinearLayout>

                    <View style="@style/RowDivider" />

                    <LinearLayout
                        android:id="@+id/btn_github"
                        style="@style/RowStyle">

                        <TextView
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="项目地址" />

                        <TextView
                            style="@style/RowChevron" />
                    </LinearLayout>

                    <View style="@style/RowDivider" />

                    <LinearLayout
                        android:id="@+id/btn_credits"
                        style="@style/RowStyle">

                        <TextView
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="致敬名单" />

                        <TextView
                            style="@style/RowChevron" />
                    </LinearLayout>

                    <View style="@style/RowDivider" />

                    <LinearLayout
                        android:id="@+id/btn_thanks"
                        style="@style/RowStyle">

                        <TextView
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="感谢名单" />

                        <TextView
                            style="@style/RowChevron" />
                    </LinearLayout>

                    <View style="@style/RowDivider" />

                    <LinearLayout
                        android:id="@+id/btn_donate"
                        style="@style/RowStyle">

                        <TextView
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="支持捐赠" />

                        <TextView
                            style="@style/RowChevron" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 诊断日志开关：文案由代码写成「诊断日志：开 / 关」 -->
                <LinearLayout
                    android:id="@+id/btn_toggle_log"
                    style="@style/RowStyle"
                    android:layout_marginTop="16dp"
                    android:background="@color/card_bg">

                    <TextView
                        android:id="@+id/tv_toggle_log"
                        style="@style/RowTitle"
                        android:layout_weight="1"
                        android:text="诊断日志：开" />

                    <TextView
                        style="@style/RowChevron" />
                </LinearLayout>

                <!-- 长按进入实验区 -->
                <LinearLayout
                    android:id="@+id/btn_lab"
                    style="@style/RowStyle"
                    android:layout_marginTop="16dp"
                    android:background="@color/card_bg">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_weight="1"
                        android:text="功能实验区"
                        android:textColor="@color/accent_warn" />

                    <TextView
                        style="@style/RowHint"
                        android:text="长按进入" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- 底部悬浮区域：只保留液态玻璃导航栏。
         【BUG 修复】旁边的手动「保存」按钮已删除：所有配置改动现在由后端
         即时 commit() + SafeWalkConfig.exportConfig()，不再需要用户手动点保存。
         悬浮叠加在 content_frame 之上，导航栏背后就是页面内容（折射源）。 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</FrameLayout>
