<?xml version="1.0" encoding="utf-8"?>
<!--
    主界面（首页 + 关于）。
    版式统一到「医疗急救卡」：灰底页（#F2F2F7）+ 平角白卡片 + 行间 1px 分隔线
    + 24sp 粗标题 + 13sp 灰副标题。原来的米黄背景、圆角磁贴、emoji 图标框全部去掉，
    因为四个二级页面各写一套视觉，改一个颜色要改四处 —— 这才是「样式不统一」的根因。

    根布局仍是 FrameLayout：底部导航栏要悬浮叠加在页面内容之上，
    这样 drawBackdrop 才能捕获到背后的画面（液态玻璃折射的前提）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ==================== 首页 ==================== -->
        <ScrollView
            android:id="@+id/page_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="110dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="安全出行"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="海阔天空，勇敢去走。步行状态由模块自行判定，不依赖 GMS。"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp" />

                <!-- 四个入口 = 一张白卡片的四行，与急救卡的字段卡同一套语言 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/card_bg"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/tile_enable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="总开关"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tile_enable_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="已关闭"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/chevron"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginLeft="16dp"
                        android:background="@color/bg" />

                    <LinearLayout
                        android:id="@+id/tile_smart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="智能提醒"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tile_smart_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="5 项全部开启"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/chevron"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginLeft="16dp"
                        android:background="@color/bg" />

                    <LinearLayout
                        android:id="@+id/tile_walk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="行走模式"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tile_walk_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="行走模式已关闭"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/chevron"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginLeft="16dp"
                        android:background="@color/bg" />

                    <LinearLayout
                        android:id="@+id/card_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="状态概览"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="运行模式"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/status_mode_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="12dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="检测中…"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="注入状态"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/status_inject_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="12dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="—"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="诊断日志"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/status_log_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="12dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="—"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="步数源"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/status_step_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="12dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="—"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- 独立模式才出现：实测用不了的功能，一条说清 -->
                        <TextView
                            android:id="@+id/status_unavailable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/text_hint"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:text="独立模式下不可用：50 步智能提醒、超级岛 / 焦点通知增强、系统 UI 适配选项" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1px"
                            android:layout_marginTop="10dp"
                            android:background="@color/bg" />

                        <!-- 尾部仍是急救卡入口（二级菜单保留） -->
                        <LinearLayout
                            android:id="@+id/tile_emergency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="急救卡"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/tile_emergency_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="点击编辑"
                                    android:textColor="@color/text_hint"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textColor="@color/chevron"
                                android:textSize="20sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- 【5.6.13 公益】寻找宝贝回家：数据源 wumisc/antiburn-missing-kids（隔天更新）。
                     首页展示前两条，点卡片打开宝贝回家官方登记页。 -->
                <LinearLayout
                    android:id="@+id/card_missing_kids"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/card_bg"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="寻找宝贝回家 · 公益"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <!-- 第一条 -->
                        <LinearLayout
                            android:id="@+id/kid_card_1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <ImageView
                                android:id="@+id/iv_kid_photo_1"
                                android:layout_width="104dp"
                                android:layout_height="104dp"
                                android:background="@color/bg"
                                android:scaleType="centerCrop"
                                android:contentDescription="走失儿童照片" />

                            <TextView
                                android:id="@+id/tv_kid_name_1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="加载中…"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_kid_info_1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="数据来自宝贝回家寻子网"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="12dp"
                            android:layout_height="match_parent" />

                        <!-- 第二条 -->
                        <LinearLayout
                            android:id="@+id/kid_card_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <ImageView
                                android:id="@+id/iv_kid_photo_2"
                                android:layout_width="104dp"
                                android:layout_height="104dp"
                                android:background="@color/bg"
                                android:scaleType="centerCrop"
                                android:contentDescription="走失儿童照片" />

                            <TextView
                                android:id="@+id/tv_kid_name_2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="加载中…"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_kid_info_2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="数据来自宝贝回家寻子网"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="发现线索请拨 110 · 点击查看详情"
                        android:textColor="@color/text_hint"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="本卡片需使用互联网权限，联网读取公开寻亲资料与照片，不上传本机隐私信息"
                        android:textColor="@color/text_hint"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ==================== 关于 ==================== -->
        <ScrollView
            android:id="@+id/page_about"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true"
            android:padding="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="110dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_about_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关于"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_about_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="安全出行 · LSPosed 模块"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:text="多少次 迎着冷眼与嘲笑，从没有放弃过心中的理想"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp"
                    android:textStyle="italic" />

                <!-- 条目卡：一行一个入口，行间分隔 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/card_bg"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btn_github"
                        style="@style/RowStyle">

                        <TextView
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="项目地址" />

                        <TextView
                            style="@style/RowChevron" />
                    </LinearLayout>

                    <View style="@style/RowDivider" />

                    <!-- 4.9.0 功能建议：把「想加什么」直接变成一条可提交的 issue，
                         不要求用户自己组织措辞，也不要求他会用 GitHub 网页。 -->
                    <LinearLayout
                        android:id="@+id/btn_feedback"
                        style="@style/RowStyle">

                        <TextView
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="功能建议" />

                        <TextView
                            style="@style/RowChevron" />
                    </LinearLayout>

                    <View style="@style/RowDivider" />

                    <LinearLayout
                        android:id="@+id/btn_credits"
                        style="@style/RowStyle">

                        <TextView
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="致敬名单" />

                        <TextView
                            style="@style/RowChevron" />
                    </LinearLayout>

                    <View style="@style/RowDivider" />

                    <LinearLayout
                        android:id="@+id/btn_thanks"
                        style="@style/RowStyle">

                        <TextView
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="感谢名单" />

                        <TextView
                            style="@style/RowChevron" />
                    </LinearLayout>

                </LinearLayout>

                <!--
                    【5.5.0 隐私】两项本地隐私开关：
                      · 隐藏桌面图标：防他人随手打开，隐藏后靠确认对话框 + 控制中心磁贴恢复；
                      · 不显示在最近任务：从系统「最近任务」里抹掉本 App。
                    两项都只改本机 App 行为，与 SystemUI 里的 Hook 无关。
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/card_bg"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:paddingTop="12dp"
                        android:text="隐私"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/btn_hide_launcher"
                        style="@style/RowStyle">

                        <TextView
                            android:id="@+id/tv_hide_launcher"
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="隐藏桌面图标" />

                        <TextView
                            android:id="@+id/tv_hide_launcher_state"
                            style="@style/RowHint"
                            android:text="已显示" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_hide_recent"
                        style="@style/RowStyle">

                        <TextView
                            android:id="@+id/tv_hide_recent"
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="不显示在最近任务" />

                        <TextView
                            android:id="@+id/tv_hide_recent_state"
                            style="@style/RowHint"
                            android:text="已显示" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="12dp"
                        android:text="步数、位置、急救信息等仅在本机处理，不上传服务器；诊断日志需在上方主动同意后才会发送。"
                        android:textColor="@color/text_hint"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 诊断日志开关：文案由代码写成「诊断日志：开 / 关」 -->
                <LinearLayout
                    android:id="@+id/btn_toggle_log"
                    style="@style/RowStyle"
                    android:layout_marginTop="16dp"
                    android:background="@color/card_bg">

                    <TextView
                        android:id="@+id/tv_toggle_log"
                        style="@style/RowTitle"
                        android:layout_weight="1"
                        android:text="诊断日志：开" />

                    <TextView
                        style="@style/RowChevron" />
                </LinearLayout>

                <!-- 诊断日志上报：手动触发；首次点击弹同意弹窗，未同意不发任何请求。 -->
                <LinearLayout
                    android:id="@+id/btn_upload_log"
                    style="@style/RowStyle"
                    android:layout_marginTop="8dp"
                    android:background="@color/card_bg">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_upload_log"
                            style="@style/RowTitle"
                            android:text="上传诊断日志" />

                        <TextView
                            android:id="@+id/tv_upload_log_hint"
                            style="@style/RowHint"
                            android:layout_marginTop="2dp"
                            android:text="未同意上传" />
                    </LinearLayout>

                    <TextView
                        style="@style/RowChevron" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- 底部悬浮区域：只保留液态玻璃导航栏。
         【BUG 修复】旁边的手动「保存」按钮已删除：所有配置改动现在由后端
         即时 commit() + SafeWalkConfig.exportConfig()，不再需要用户手动点保存。
         悬浮叠加在 content_frame 之上，导航栏背后就是页面内容（折射源）。 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</FrameLayout>
