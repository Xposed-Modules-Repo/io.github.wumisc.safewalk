<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F0E8"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="后置看路设置"
        android:textColor="#1A1A1A"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="走路时用后置摄像头看前方路况"
        android:textColor="#8B7D6B"
        android:textSize="13sp" />

    <!-- 形态选择 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="显示形态"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/option_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="14dp"
        android:background="#FFFCF5"
        android:text="📱 全屏半透明叠加"
        android:textColor="#2D2D2D"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/option_smallwindow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="14dp"
        android:background="#FFFCF5"
        android:text="🪟 右下角小窗"
        android:textColor="#2D2D2D"
        android:textSize="15sp" />

    <!-- 自动模式 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="自动模式"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="走起来自动开、停下自动收"
        android:textColor="#8B7D6B"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/option_auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:background="#FFFCF5">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="自动检测步行"
            android:textColor="#2D2D2D"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/option_auto_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已开启"
            android:textColor="#2D7A3E"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 说明 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="14dp"
        android:background="#EDE6D6"
        android:text="💡 提示：\n• 悬浮窗触摸完全穿透，不挡操作\n• 顶部不高于状态栏\n• 进入相机类app自动收起避让"
        android:textColor="#8B7D6B"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
