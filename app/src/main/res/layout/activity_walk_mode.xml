<?xml version="1.0" encoding="utf-8"?>
<!--
    行走模式。
    版式统一到「医疗急救卡」：灰底页 + 平角白卡片 + 1px 分隔线 + 24sp 粗标题。
    原来开关、滑块、选项各自一张圆角卡，卡片间距和内边距各写各的；
    现在统一用 styles.xml 里的 RowStyle / CardStyle / SectionLabel，参数只有一处。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:padding="16dp"
    android:paddingTop="40dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingVertical="4dp"
            android:text="‹ 返回"
            android:textColor="@color/primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="行走模式"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hero_walk_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="用后置摄像头把身后路况叠在屏幕上"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <!-- 预览开关 -->
        <LinearLayout style="@style/CardStyle" android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/card_rear_cam"
                style="@style/RowStyle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="路况预览" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_marginTop="2dp"
                        android:text="开启后按下方方式显示后置摄像头画面" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_rear_cam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <TextView
                android:id="@+id/tv_cam_perm_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <View style="@style/RowDivider" />

            <!-- 显示方式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="显示方式"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_mode_full"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_choice_chip"
                        android:gravity="center"
                        android:text="全屏滤镜"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_mode_small"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_choice_chip"
                        android:gravity="center"
                        android:text="角落小窗"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/RowDivider" />

            <!-- 小窗位置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tv_corner_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小窗位置"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_pos_tl"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_choice_chip"
                        android:gravity="center"
                        android:text="左上"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_pos_tr"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_choice_chip"
                        android:gravity="center"
                        android:text="右上"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_pos_bl"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_choice_chip"
                        android:gravity="center"
                        android:text="左下"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_pos_br"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_choice_chip"
                        android:gravity="center"
                        android:text="右下"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- 自动跟随 -->
        <LinearLayout style="@style/CardStyle" android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/card_auto"
                style="@style/RowStyle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="自动跟随步行" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_marginTop="2dp"
                        android:text="走起来才显示，停下自动收起" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <TextView
                android:id="@+id/tv_auto_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 显示参数 -->
        <TextView
            style="@style/SectionLabel"
            android:text="显示参数" />

        <LinearLayout style="@style/CardStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tv_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="画面不透明度"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <SeekBar
                    android:id="@+id/seek_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="90" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="范围 10% ~ 100%，越低越能看清底下的界面"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <!-- 【新增对比度 UI 模块】增强对比度独立开关：与透明度滑块共存 -->
                <View
                    style="@style/RowDivider"
                    android:layout_marginTop="12dp"
                    android:layout_marginLeft="0dp" />

                <LinearLayout
                    android:id="@+id/card_preview_contrast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="增强对比度"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="文字加描边/阴影/深色衬底，画面透明度照旧，兼顾看路况与看字"
                            android:textColor="@color/text_hint"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_preview_contrast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 【对比度强度进度条】与开关卡片平级：点进度条不会误触发开关 toggle。
                     开关是总闸，滑条调 HUD 描边/阴影/衬底强弱（0~100）。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="强度"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_contrast_level"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="50% · 适中"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_contrast_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="50" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="越高描边/阴影/衬底越重，越低越接近原始画面；不影响透明度"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- 步态参数 -->
        <TextView
            style="@style/SectionLabel"
            android:text="步态判定" />

        <LinearLayout style="@style/CardStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp">

                <TextView
                    android:id="@+id/tv_gait_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="连续走多少步算「在走路」"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <SeekBar
                    android:id="@+id/seek_gait_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="8" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tv_gait_stop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="停下后多久收起预览"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <SeekBar
                    android:id="@+id/seek_gait_stop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="25" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <TextView
                android:id="@+id/tv_preview_stage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 快捷入口 -->
        <TextView
            style="@style/SectionLabel"
            android:text="快捷入口" />

        <LinearLayout style="@style/CardStyle">

            <LinearLayout
                android:id="@+id/card_add_tile"
                style="@style/RowStyle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="添加到控制中心" />

                    <TextView
                        android:id="@+id/tv_add_tile_desc"
                        style="@style/RowHint"
                        android:layout_marginTop="2dp"
                        android:text="下拉控制中心点一下就开，不用再进应用" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_add_tile_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="添加"
                    android:textColor="@color/seal_red"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- 维护 -->
        <TextView
            style="@style/SectionLabel"
            android:text="维护" />

        <LinearLayout style="@style/CardStyle">

            <LinearLayout
                android:id="@+id/card_restart_systemui"
                style="@style/RowStyle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="重启系统界面" />

                    <TextView
                        android:id="@+id/tv_restart_desc"
                        style="@style/RowHint"
                        android:layout_marginTop="2dp"
                        android:text="改完模块设置后需要重启 SystemUI 才会生效" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_restart_systemui"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/seal_red"
                    android:minWidth="0dp"
                    android:text="重启"
                    android:textColor="@color/on_accent"
                    android:textSize="13sp" />
            </LinearLayout>

        <!-- 「系统 UI 适配」入口只在首页（activity_main.xml / MainActivity），
             本二级菜单不再重复提供，避免出现两个配置入口。 -->

        </LinearLayout>

    </LinearLayout>
</ScrollView>
