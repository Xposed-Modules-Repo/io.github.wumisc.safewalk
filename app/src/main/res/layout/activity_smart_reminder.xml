<?xml version="1.0" encoding="utf-8"?>
<!--
    智能提醒。
    版式统一到「医疗急救卡」：灰底页 + 平角白卡片 + 1px 分隔线 + 24sp 粗标题。
    原来每个提醒项都是一张独立的圆角卡，还各带一个 40dp emoji 图标框，
    六个开关就写了六遍几乎一样的 60 行 XML —— 这就是「代码过于省略、不规范」的来源。
    现在改成一整张卡片 + 行式布局，行的公共属性收进 styles.xml（RowStyle / RowTitle …），
    以后加一个开关只要复制四行。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:padding="16dp"
    android:paddingTop="40dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingVertical="4dp"
            android:text="‹ 返回"
            android:textColor="@color/primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="智能提醒"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hero_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="6 项提醒 · 已开启 0 项"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <!-- 全部开 / 全部关：主按钮 + 次按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_all_on"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/primary"
                android:text="全部开启"
                android:textColor="@color/on_accent" />

            <Button
                android:id="@+id/btn_all_off"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/card_bg"
                android:text="全部关闭"
                android:textColor="@color/primary" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="提醒项" />

        <LinearLayout style="@style/CardStyle">

            <LinearLayout
                android:id="@+id/card_battery"
                style="@style/RowStyle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="电量预警" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_marginTop="2dp"
                        android:text="电量低于 15% 时提醒充电" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:id="@+id/card_idcard"
                style="@style/RowStyle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="证件提醒" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_marginTop="2dp"
                        android:text="到达车站 / 机场 / 景区 / 酒店时提醒证件贴身存放" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_idcard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:id="@+id/card_sit"
                style="@style/RowStyle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="久坐提醒" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_marginTop="2dp"
                        android:text="连续静坐 2 小时提醒起身活动" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_sit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:id="@+id/card_head_down"
                style="@style/RowStyle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="低头提醒" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_marginTop="2dp"
                        android:text="走路时一直盯着手机，提醒你抬头看路（参考 Pixel 数字健康）" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_head_down"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:id="@+id/card_night_torch"
                style="@style/RowStyle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="夜间提醒" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_marginTop="2dp"
                        android:text="22:00–06:00 出门时建议开手电" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_night_torch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:id="@+id/row_night_time"
                style="@style/RowStyle">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="生效时段"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_night_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <TextView style="@style/RowChevron" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <!-- 合并「夜间自动开灯」与「夜间手电·小窗联动」为单一开关：
                 原两条开关本质同一功能，用户确认只需一个开关。保留「小窗联动」这条
                 （App 侧预览会话内点灯、随小窗显示/收起，不抢摄像头、不误触床上抖动），
                 删除旧的 SystemUI 侧 lux 暗光独立点灯路径。 -->
            <LinearLayout
                android:id="@+id/card_night_torch_gait"
                style="@style/RowStyle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="夜间手电" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_marginTop="2dp"
                        android:text="夜间时段内，角落小窗显示时闪光灯一起点亮，小窗收起自动熄灭" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_night_torch_gait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:id="@+id/card_social"
                style="@style/RowStyle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="到场提示" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_marginTop="2dp"
                        android:text="到达面试 / 约会 / 聚会等场所时，按场所类型提一条礼节" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_social"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="出行模式" />

        <LinearLayout style="@style/CardStyle">

            <LinearLayout style="@style/RowStyle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="基于定位自动识别" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_marginTop="2dp"
                        android:text="自动判断你在什么场合，切换对应模式" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_auto_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <TextView
                android:id="@+id/tv_auto_mode_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text=""
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <View style="@style/RowDivider" />

            <TextView
                android:id="@+id/tv_travel_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:text="到场提示会按「识别到的场所类型」自动匹配模板（求职 / 约会 / 聚会 / 旅游各一套），这里的手动选择仅作偏好记录"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/row_mode_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/chip_job"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice_chip"
                    android:gravity="center"
                    android:text="求职"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chip_date"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice_chip"
                    android:gravity="center"
                    android:text="约会"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chip_party"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice_chip"
                    android:gravity="center"
                    android:text="聚会"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chip_travel"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice_chip"
                    android:gravity="center"
                    android:text="旅游"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="夜间手电 · 静置提醒" />

        <LinearLayout style="@style/CardStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tv_torch_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="手电开着静置 20 分钟后提醒省电"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <SeekBar
                    android:id="@+id/seek_torch_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="55"
                    android:progress="15" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="范围 5 ~ 60 分钟"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="修改即时生效，无需点击保存"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
