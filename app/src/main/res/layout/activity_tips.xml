<?xml version="1.0" encoding="utf-8"?>
<!--
    出门踩坑指南。

    原来是「宣纸渐变背景 + 2x2 圆角磁贴」，配色走的是旧色板（@color/bg_end 等）。
    系统切深色后：背景变 #000000、卡片也变 #1C1C1E，卡片和背景同色 → 整页看起来
    就是一片黑，只剩四个 emoji 浮在上面（用户反馈的「出 bug」就是这个）。

    现在改成和首页一致的版式：灰底页 + 白卡片 + 行式入口 + 行间 1px 分隔线，
    颜色全部走 token，深浅色都成立。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tips_scroll"
    style="@style/PageScroll">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btn_back"
            style="@style/BackLink"
            android:text="‹ 返回" />

        <TextView
            style="@style/PageTitle"
            android:layout_marginTop="12dp"
            android:text="出门踩坑指南" />

        <TextView
            style="@style/PageSubtitle"
            android:text="选择场景，查看避坑清单" />

        <!-- 场景入口：一张卡四行 -->
        <LinearLayout style="@style/CardStyle">

            <LinearLayout
                android:id="@+id/tile_job"
                style="@style/RowStyle">

                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="💼　求职" />

                <TextView style="@style/RowChevron" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:id="@+id/tile_date"
                style="@style/RowStyle">

                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="❤️　约会" />

                <TextView style="@style/RowChevron" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:id="@+id/tile_party"
                style="@style/RowStyle">

                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="🎉　聚会" />

                <TextView style="@style/RowChevron" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:id="@+id/tile_travel"
                style="@style/RowStyle">

                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="🗺️　旅游" />

                <TextView style="@style/RowChevron" />
            </LinearLayout>

        </LinearLayout>

        <!-- 内容卡片：默认隐藏，点场景后出现 -->
        <LinearLayout
            android:id="@+id/card_content"
            style="@style/CardStyle"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_content_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_content"
                style="@style/BodyText"
                android:layout_marginTop="10dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
