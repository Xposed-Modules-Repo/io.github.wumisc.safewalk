<?xml version="1.0" encoding="utf-8"?>
<!-- 开关轨道配色：开启用行走绿，关闭用宣纸灰。
     用 ColorStateList 而非直接写色值，避免不同 ROM 的默认强调色污染主题。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/accent_walk" android:state_checked="true" />
    <item android:color="#D8CDB4" />
</selector>
