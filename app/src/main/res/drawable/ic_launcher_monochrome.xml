<?xml version="1.0" encoding="utf-8"?>
<!--
  主题图标（monochrome）层。

  ## 为什么必须单独画，不能拿前景去色
  HyperOS 3 / MagicOS / ColorOS 15 / OriginOS 5 的主题图标会把这一层当
  alpha 蒙版整体着色。直接把彩色前景去色会有两个问题：
  1. 五官（1.7dp 笑眼 / 嘴角）、伞骨（0.9dp）、高光这些细线在 48dp 下
     糊成噪点，白色蒙版上就是一团脏；
  2. 半透明伞面去色后会变成实心块，和头发、脸连在一起认不出层次。

  所以这里只保留大剪影：伞面 + 伞柄 + 头 + 身 + 撑伞手臂 + ✌️ 手臂和
  两根手指 + 双腿。删掉笑眼、嘴角、腮红、刘海、伞骨、高光、雨靴等全部
  细线；伞骨改实心伞面、伞柄加粗到 2.8dp、✌️ 手指加粗到 3.2dp，
  保证 48dp 下仍是「打透明伞 + 比剪刀手的小女孩」一个整体形状。

  ## 为什么各块之间要留空隙
  伞面下缘 y≈41、头顶 y=49；头右缘 x≈65（圆心 56、半径 9）、✌️ 手掌
  圆心 x=72、左缘 x=69（半径 3），两者间隙 ≈4dp（约 1.8dp @48dp），
  避免白色剪影连成一坨看不出结构。

  ## 为什么用纯白
  系统会按主题色给这一层重新着色（或反相），白色是唯一安全的基色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 伞面（实心白，波浪简化成两段，缩小后轮廓更稳；不画伞骨/高光） -->
    <path
        android:pathData="M26,40 C26,30 33,25 42,25 C51,25 60,30 60,40
        Q53,43 42.5,40 Q32,43 26,40 Z"
        android:fillColor="#FFFFFF" />

    <!-- 伞柄（2.8dp，J 形弯钩保留，是「伞」的关键识别特征） -->
    <path
        android:pathData="M42,27 L40,55 L40,63 Q40,67 44.5,66.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />

    <!-- 头（圆剪影，不加五官与刘海；中心略左移，给右侧剪刀手让出空隙） -->
    <path
        android:pathData="M47,58 A9,9 0 1,0 65,58 A9,9 0 1,0 47,58 Z"
        android:fillColor="#FFFFFF" />

    <!-- 身体（比彩色版略宽，避免小尺寸下变成一根竖条） -->
    <path
        android:pathData="M47,67.5 Q57,63.5 67,67.5 L70.5,79 Q57,83.5 43.5,79 Z"
        android:fillColor="#FFFFFF" />

    <!-- 撑伞手臂（画面左） -->
    <path
        android:pathData="M48.5,70.5 L40,57"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round" />
    <!-- 握住伞柄的手：小圆剪影，把手臂和伞柄接成一体 -->
    <path
        android:pathData="M36.5,55 A3,3 0 1,0 36.5,61 A3,3 0 1,0 36.5,55 Z"
        android:fillColor="#FFFFFF" />

    <!-- ✌️ 手臂（画面右） -->
    <path
        android:pathData="M65,70.5 L74,56.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round" />
    <!-- 手掌剪影（不含收拢指节细节） -->
    <path
        android:pathData="M72,54 A3,3 0 1,0 72,60 A3,3 0 1,0 72,54 Z"
        android:fillColor="#FFFFFF" />

    <!-- ✌️ 两根手指：V 形张到头侧上方，3.2dp 圆头，48dp 下仍是清晰的「二」 -->
    <path
        android:pathData="M73.5,54.5 L71,46"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M75.5,54 L78.5,45.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />

    <!-- 双腿（3.6dp，分行 drawing，避免缩成一根） -->
    <path
        android:pathData="M51.5,79.5 L51,84"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M59,79.5 L59.5,84"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round" />
</vector>
