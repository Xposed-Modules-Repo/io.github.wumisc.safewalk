<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景（108 × 108 dp 画布）：深色雨夜里开心的小女孩。

  ## 为什么重画
  旧前景是「纯黑圆点脑袋 + 不透明蓝伞 + 雨滴」，48dp 下看不出表情，
  完全不像「开心的小女孩」。这一版按需求换成正面笑脸 + 一只手比✌️ +
  另一只手撑透明伞；仍是纯矢量，任意密度原生渲染。

  ## 构图与安全区（>33dp 的部分没有）
  各家遮罩（圆 / 圆角方 / 方圆 / 水滴）会裁掉四角与边缘，所以所有图元
  都收在以 (54,54) 为心、半径约 33 的圆内：伞顶 (42,25) 距心 31.4、
  伞左缘 (26,40) 距心 31.3、脚底 (61.5,83.5) 距心 30.4，四角留白。
  伞偏左上、女孩偏右中、✌️ 举在右侧，三块互不重叠。

  ## 为什么伞是「透明」的
  伞面用浅蓝白 #D6ECFF + fillAlpha=0.30，深色背景能透上来；再叠
  1.3dp 浅色轮廓、0.9dp 伞骨和一道高光，就是「看得见骨头的透明伞」，
  而不是旧版 fill 不透明的实心蓝伞。伞柄末端保留 J 形弯钩，是「伞」
  在小尺寸下最关键的识别特征。

  ## 为什么五官用粗线
  48dp 下五官最容易糊掉：笑眼（上弯的 ^ 形）和嘴角都用 1.7~1.8dp、
  圆头收尾；笑脸腮红 alpha 0.65（大尺寸添俏皮，小尺寸自然淡出）。
  脸用暖肤 #FFD9B8、衣服用暖橙渐变，在深靛蓝背景上形成明暗反差。

  ## 为什么拆这么多 path
  · 头发 / 脸 / 刘海分三层：单色圆点读不出「女孩」，分层才有发型；
  · 伞面、伞骨、高光分开：透明伞靠叠加层次，不是一块平涂；
  · 手臂与手指分画：✌️ 的两根手指必须独立成线，否则缩成一团。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 透明伞面：浅蓝白半透明，深背景透上来才有「透明伞」质感 -->
    <path
        android:pathData="M26,40 C26,30 33,25 42,25 C51,25 60,30 60,40
        Q56,43.5 51.25,40 Q46.9,43.5 42.5,40 Q38.1,43.5 33.75,40
        Q30.4,42.5 26,40 Z"
        android:fillColor="#D6ECFF"
        android:fillAlpha="0.3"
        android:strokeColor="#C2E2FF"
        android:strokeWidth="1.3"
        android:strokeAlpha="0.85"
        android:strokeLineJoin="round" />

    <!-- 伞骨：从伞顶放射到波浪下缘，0.9dp 细线只在大尺寸可见 -->
    <path
        android:pathData="M42,26 L33.75,41.5"
        android:strokeColor="#BDDCF5"
        android:strokeWidth="0.9"
        android:strokeAlpha="0.45" />
    <path
        android:pathData="M42,26 L51.25,41.5"
        android:strokeColor="#BDDCF5"
        android:strokeWidth="0.9"
        android:strokeAlpha="0.45" />

    <!-- 顶部高光：一道斜弧，给透明伞面一层湿润的玻璃亮边 -->
    <path
        android:pathData="M32,37 C33,31 37,27.5 41,26"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeAlpha="0.3"
        android:strokeLineCap="round" />

    <!-- 伞柄：从伞顶穿下（透过半透明伞面可见），末端 J 形弯钩朝右回扣 -->
    <path
        android:pathData="M42,27 L40,55 L40,63 Q40,67 44.5,66.5"
        android:strokeColor="#B9D9F2"
        android:strokeWidth="2"
        android:strokeAlpha="0.95"
        android:strokeLineCap="round" />

    <!-- 头发底色：包住脸的两侧与顶部，先画在底层 -->
    <path
        android:pathData="M57,46 C49.5,46 46.5,50.5 46.5,58 L46.5,63
        C46.5,65 49.5,65.5 50.5,62.5 L51.5,56 C52,51.5 53.5,49.5 57,49.5
        C60.5,49.5 62,51.5 62.5,56 L63.5,62.5 C64.5,65.5 67.5,65 67.5,63
        L67.5,58 C67.5,50.5 64.5,46 57,46 Z"
        android:fillColor="#5C3A34" />

    <!-- 脸：暖色浅肤正对观看者，圆脸保证「正面」一眼可读 -->
    <path
        android:pathData="M48.5,59.5 A8.5,8.5 0 1,0 65.5,59.5 A8.5,8.5 0 1,0 48.5,59.5 Z"
        android:fillColor="#FFD9B8" />

    <!-- 刘海：盖在额头上，与两侧头发连成「小女孩」发型 -->
    <path
        android:pathData="M48.6,56 C49.5,50.5 52.5,48.5 57,48.5 C61.5,48.5 64.5,50.5 65.4,56
        C63,52.5 60.5,51.5 57,51.5 C53.5,51.5 51,52.5 48.6,56 Z"
        android:fillColor="#5C3A34" />

    <!-- 笑眼：上弯的 ^ 形（眯眼笑），1.7dp 圆头，48dp 也看得出在笑 -->
    <path
        android:pathData="M52,60.5 Q53.5,58.7 55,60.5"
        android:strokeColor="#3F2B2A"
        android:strokeWidth="1.7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M59,60.5 Q60.5,58.7 62,60.5"
        android:strokeColor="#3F2B2A"
        android:strokeWidth="1.7"
        android:strokeLineCap="round" />

    <!-- 腮红：alpha 0.65，大尺寸添俏皮，小尺寸自然淡出 -->
    <path
        android:pathData="M51.5,63.5 A1.8,1.8 0 1,0 51.5,67.1 A1.8,1.8 0 1,0 51.5,63.5 Z"
        android:fillColor="#FF9A8A"
        android:fillAlpha="0.65" />
    <path
        android:pathData="M62.5,63.5 A1.8,1.8 0 1,0 62.5,67.1 A1.8,1.8 0 1,0 62.5,63.5 Z"
        android:fillColor="#FF9A8A"
        android:fillAlpha="0.65" />

    <!-- 嘴角上扬的微笑：1.8dp 圆头，是「开心」最关键的一笔 -->
    <path
        android:pathData="M54,64.5 Q57,67.5 60,64.5"
        android:strokeColor="#B4504A"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <!-- 身体：暖橙渐变雨衣，肩线 y≈67 与头部（底 68）重叠，避免「头浮在衣服上」 -->
    <path android:pathData="M48.5,68 Q57,64.5 65.5,68 L69,79 Q57,83 45,79 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="57"
                android:startY="65"
                android:endX="57"
                android:endY="82"
                android:startColor="#FFC978"
                android:endColor="#E8843C" />
        </aapt:attr>
    </path>

    <!-- 撑伞的手臂（女孩右手，画面左）：从肩膀伸向伞柄握点 -->
    <path
        android:pathData="M49,71 L40,57"
        android:strokeColor="#FFD9B8"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M36.9,55.5 A2.6,2.6 0 1,0 36.9,60.7 A2.6,2.6 0 1,0 36.9,55.5 Z"
        android:fillColor="#FFD9B8" />

    <!-- 比✌️的手臂（女孩左手，画面右）：举在头侧，与伞面错开不打架 -->
    <path
        android:pathData="M65,71 L73,58"
        android:strokeColor="#FFD9B8"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M71.4,56 A2.6,2.6 0 1,0 71.4,61.2 A2.6,2.6 0 1,0 71.4,56 Z"
        android:fillColor="#FFD9B8" />

    <!-- ✌️ 两根手指：V 形张开、2.8dp 圆头，小尺寸也是清晰的「二」 -->
    <path
        android:pathData="M73.5,55.5 L71,47"
        android:strokeColor="#FFD9B8"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M74.5,55 L78,46.5"
        android:strokeColor="#FFD9B8"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />
    <!-- 收拢的指节：紧贴手掌的一小团，暗示另外两根手指蜷着 -->
    <path
        android:pathData="M72,57 Q74.5,54.5 77,56 Q75,59 72,57 Z"
        android:fillColor="#F7C9A3" />

    <!-- 双腿与小雨靴：短粗收在底部，脚底 y=83.5 距圆心 <31dp -->
    <path
        android:pathData="M52,79 L51.5,83"
        android:strokeColor="#C9692F"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M59,79 L59.5,83"
        android:strokeColor="#C9692F"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M49.5,83.5 L53,83.5"
        android:strokeColor="#3A2A2E"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M58,83.5 L61.5,83.5"
        android:strokeColor="#3A2A2E"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
</vector>
