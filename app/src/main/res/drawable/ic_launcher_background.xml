<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标背景层。

  ## 为什么再压暗一档
  旧渐变顶部 #123C66 偏亮蓝，整体更像「阴天」而不是用户要的深色夜景。
  这版改成深靛蓝 #1B2154 → 近黑 #05060D：顶部还留一点冷蓝表明是雨夜，
  往下迅速沉到近黑，前景的暖肤笑脸、暖橙雨衣和浅蓝透明伞才能跳出来。

  ## 为什么仍是自上而下的渐变
  纯色在 48dp 下会发闷、和深色桌面糊成一片；angle=270 的线性渐变给
  前景铺出「上亮下暗」的舞台。渐变只在背景层，不参与遮罩裁剪，
  圆 / 圆角方 / 方圆 / 水滴四种形状下都居中。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#1B2154"
        android:endColor="#05060D"
        android:type="linear" />
</shape>
