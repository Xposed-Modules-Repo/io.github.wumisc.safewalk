<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/page_settings"
            android:padding="16dp"
            android:paddingBottom="100dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="安全出行"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#ff007aff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="�� 总开关"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/text_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="启用路况"/>
                            <Switch
                                android:id="@+id/sw_enable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <Space
                        android:layout_width="10dp"
                        android:layout_height="0dp"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#ff34c759"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="�� 自动行走"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/text_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="检测步行节奏"/>
                            <Switch
                                android:id="@+id/sw_auto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="10dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#ffff9500"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="�� 看路提醒"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/text_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="低头看手机提醒"/>
                            <Switch
                                android:id="@+id/sw_lookdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <Space
                        android:layout_width="10dp"
                        android:layout_height="0dp"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#ffaf52de"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="�� 夜间手电"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/text_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="22~7点行走提醒"/>
                            <Switch
                                android:id="@+id/sw_night_flash"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#ffff3b30"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="��️ 安全扩展"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/text_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="电量/证件/久坐/礼仪"/>
                            <Switch
                                android:id="@+id/sw_safety"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <Space
                        android:layout_width="10dp"
                        android:layout_height="0dp"/>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_emergency"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#ffff2d55"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="�� 急救卡"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/text_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="本地保存医疗信息"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/primary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="点击编辑 →"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="15sp"
                                android:textColor="@color/text_primary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="手动行走模式"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/text_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="手动开启后始终显示路况"/>
                        </LinearLayout>
                        <Switch
                            android:id="@+id/sw_walk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="画面形态"/>
                        <RadioGroup
                            android:orientation="horizontal"
                            android:id="@+id/rg_form"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">
                            <RadioButton
                                android:id="@+id/rb_full"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="全屏半透明"
                                android:layout_weight="1"/>
                            <RadioButton
                                android:id="@+id/rb_corner"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="角落小窗"
                                android:layout_weight="1"/>
                        </RadioGroup>
                        <View
                            android:background="@color/divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:id="@+id/tv_alpha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="画面不透明度：55%"/>
                        <SeekBar
                            android:id="@+id/seek_alpha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="100"/>
                        <View
                            android:background="@color/divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="角落小窗位置"/>
                        <RadioGroup
                            android:orientation="horizontal"
                            android:id="@+id/rg_corner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">
                            <RadioButton
                                android:id="@+id/rb_tl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="左上"
                                android:layout_weight="1"/>
                            <RadioButton
                                android:id="@+id/rb_tr"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="右上"
                                android:layout_weight="1"/>
                            <RadioButton
                                android:id="@+id/rb_bl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="左下"
                                android:layout_weight="1"/>
                            <RadioButton
                                android:id="@+id/rb_br"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="右下"
                                android:layout_weight="1"/>
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="低头持续秒数"
                            android:layout_weight="1"/>
                        <EditText
                            android:textSize="14sp"
                            android:gravity="center"
                            android:id="@+id/et_lookdown_sec"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:hint="3"
                            android:maxLines="1"
                            android:inputType="number"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="定位权限引导"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Android 11+ 后台定位需手动开启：\101. 先点下方按钮授予前台位置\102. 再跳系统设置选「始终允许」\10路径：设置→隐私保护→位置信息→SafeWalk→始终允许"
                            android:lineSpacingExtra="4dp"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:id="@+id/tv_loc_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="当前状态：未授权"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_req_fg_loc"
                                android:focusable="true"
                                android:clickable="true"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/button_bg"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp">
                                <TextView
                                    android:textSize="13sp"
                                    android:textColor="@color/primary"
                                    android:gravity="center"
                                    android:padding="10dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="① 授予前台位置"/>
                            </com.google.android.material.card.MaterialCardView>
                            <Space
                                android:layout_width="8dp"
                                android:layout_height="0dp"/>
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_req_bg_loc"
                                android:focusable="true"
                                android:clickable="true"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/button_bg"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp">
                                <TextView
                                    android:textSize="13sp"
                                    android:textColor="@color/primary"
                                    android:gravity="center"
                                    android:padding="10dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="② 开启后台定位"/>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:id="@+id/page_about"
            android:background="@color/bg"
            android:padding="16dp"
            android:paddingBottom="100dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/about_logo"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/about_logo"
                    android:contentDescription="安全出行图标"/>
                <TextView
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_about_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="关于"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/text_hint"
                    android:id="@+id/tv_about_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="安全出行 · LSPosed 模块"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:textColor="@color/seal_red"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="多少次 迎着冷眼与嘲笑，从没有放弃过心中的理想"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:weightSum="2">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_tips"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="28sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="��"/>
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="踩坑指南"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_github"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="28sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="��"/>
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="项目地址"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_credits"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="28sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="��️"/>
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
