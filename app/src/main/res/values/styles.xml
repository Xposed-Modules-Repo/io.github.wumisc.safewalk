<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        全局版式（首页 / 关于 / 急救卡 / 智能提醒 / 行走模式 / 致敬名单 / 感谢名单 / 支持捐赠 / 实验区共用）。

        为什么抽成 style：这些页面原来各写各的 padding、字号和颜色，改一次全局要改七八处，
        还容易漏（漏掉的那页在深色下就露馅）。现在颜色一律走 @color token，
        values-night 一改，所有页面同时生效。
    -->

    <!-- 页面内边距：16dp 边 + 40dp 顶（避开状态栏），底部留白给悬浮导航 -->
    <style name="PageScroll">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/bg</item>
        <item name="android:fillViewport">true</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">40dp</item>
        <item name="android:paddingBottom">110dp</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:scrollbars">none</item>
    </style>

    <!-- 页面标题：24sp 粗体 -->
    <style name="PageTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 页面副标题：13sp 灰 -->
    <style name="PageSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 返回按钮（二级页左上角） -->
    <style name="BackLink">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 一行：可点击、左右留白 16dp、上下 14dp、按下有水波纹 -->
    <style name="RowStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 不可点击的行（纯展示/放开关） -->
    <style name="RowStatic" parent="RowStyle">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:background">@null</item>
    </style>

    <!-- 行标题：16sp，主文字色 -->
    <style name="RowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 行内说明（标题下方的小字） -->
    <style name="RowDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 行副标题 / 右侧说明文字 -->
    <style name="RowHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 右侧箭头 -->
    <style name="RowChevron">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">›</item>
        <item name="android:textColor">@color/chevron</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- 行间分隔线：左起 16dp 缩进 -->
    <style name="RowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1px</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- 白色卡片容器：垂直排列、平角（与急救卡一致） -->
    <style name="CardStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@color/card_bg</item>
    </style>

    <!-- 区块小标题 -->
    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 主按钮（蓝底白字）。
         注意：Material 主题下 <Button> 会被替换成 MaterialButton，它自带背景，
         android:background 不生效，必须用 backgroundTint。 -->
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 次按钮（卡底 + 蓝字） -->
    <style name="SecondaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:backgroundTint">@color/card_bg</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 表格里的开关行（右侧放 SwitchCompat） -->
    <style name="SwitchRow" parent="RowStatic">
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- 卡片内的正文（长文本、清单） -->
    <style name="BodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineSpacingExtra">6dp</item>
        <item name="android:textColor">@color/text_body</item>
        <item name="android:textSize">14sp</item>
    </style>
    <!--
        【系统 UI 适配】首页那一行选择芯片。

        七个芯片（自动 + 五家厂商 + 原生）均分一行，360dp 宽的机器上每个只有约 43dp。
        所以芯片文字用厂商短名（小米/荣耀/OPPO/vivo/华为/原生，最多 4 个字符），
        再开 autoSize 兜底：系统按可用宽度自己缩字号，永远不溢出、也不会被 ellipsize
        截成 "Orig…"。minSdk 33，原生 TextView 支持 autoSize（API 26+），不需要 AppCompat。

        宽度/高度/权重写进 style，布局里只留 margin 与文字，省得七段重复属性。
    -->
    <style name="RomChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_choice_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMaxTextSize">11sp</item>
        <item name="android:autoSizeMinTextSize">7sp</item>
        <item name="android:autoSizeStepGranularity">0.5sp</item>
    </style>

</resources>
