<?xml version="1.0" encoding="utf-8"?>
<!--
    唯一色板（浅色）。

    历史包袱：这里原来是「宣纸 + 靛蓝」一套，values-night 里又塞了一套 Miuix 深色，
    而首页/关于页的布局直接硬编码了第三套 iOS 灰白。三套并存的结果就是：
    系统切深色后首页原样不动、踩坑指南整页变黑卡片看不见、导航栏还是浅色。

    现在只留这一套语义色，所有布局、drawable、代码都只引用这里；
    深色值全部在 values-night/colors.xml 里覆盖，不再有第二套命名。
-->
<resources>

    <!-- 页面底色 / 卡片底色 -->
    <color name="bg">#F2F2F7</color>
    <color name="card_bg">#FFFFFF</color>

    <!-- 文字：主标题 / 正文 / 说明 / 更弱的灰 -->
    <color name="text_primary">#1D1D1D</color>
    <color name="text_body">#3A3A3C</color>
    <color name="text_hint">#8E8E93</color>
    <color name="text_muted">#B0B0B5</color>

    <!-- 行尾箭头、分隔线、卡片描边 -->
    <color name="chevron">#C7C7CC</color>
    <color name="divider">#E5E5EA</color>
    <color name="stroke">#E5E5EA</color>

    <!-- 主色（按钮、开关、选中态、链接） -->
    <color name="primary">#007AFF</color>
    <color name="on_accent">#FFFFFF</color>

    <!-- 语义色：警告 / 正常 / 危险（急救提醒用） -->
    <color name="accent_warn">#FF9500</color>
    <color name="beyond_orange">#FF9500</color>
    <color name="accent_green">#34C759</color>
    <color name="seal_red">#C8392E</color>

    <!-- 选项胶囊：选中实底 / 未选中描边由 drawable 引用 -->
    <color name="chip_solid">#007AFF</color>
    <color name="chip_stroke">#D1D1D6</color>

    <!-- 底部导航、遮罩 -->
    <color name="nav_bg">#FFFFFF</color>
    <color name="bg_overlay">#70FFFFFF</color>

    <!-- 自适应图标背景：取自新图标（雨伞插画）四角的深夜蓝，与前景图透明外沿无缝衔接 -->

</resources>
